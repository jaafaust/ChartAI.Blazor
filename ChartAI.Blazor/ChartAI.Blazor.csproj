<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <!-- PackageId also defines the static asset base path (_content/ChartAI.Blazor/...)
         that Chart.razor.cs imports from. Do not change it without updating that path. -->
    <PackageId>ChartAI.Blazor</PackageId>
    <!-- Overridden by the release workflow from the git tag (v1.2.3 -> 1.2.3). -->
    <Version>1.1.4</Version>
    <Authors>jaafaust</Authors>
    <Title>ChartAI for Blazor</Title>
    <Description>Blazor component wrapping the chartai WebGPU charting engine: GPU-rendered line, area, scatter, bar, candlestick, OHLC, step, histogram, heatmap, bubble, baseline-area, error-band and waterfall charts with zoom, tooltips, legends, annotations, thresholds, multiple Y axes and interactive plugins (crosshair, ruler, minimap, range selector, stats, tooltip pin).</Description>
    <PackageTags>blazor;chart;charts;charting;webgpu;gpu;visualization;plot;razor;wasm;chartai</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/jaafaust/ChartAI.Blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jaafaust/ChartAI.Blazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>See https://github.com/jaafaust/ChartAI.Blazor/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <Copyright>Copyright (c) 2026 jaafaust</Copyright>
  </PropertyGroup>

  <!-- Build / symbols / Source Link -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Many public config members are self-describing; do not warn on missing XML docs. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- The tests can check the interop payloads (Components/ChartWire.cs), which are internal. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ChartAI.Blazor.Tests" />
  </ItemGroup>

  <!-- chartai engine: wwwroot/chartai.js is generated from the TypeScript in engine/src by
       engine/build.ts (Bun, https://bun.sh). The bundle is committed, so a build without Bun
       still works; when Bun is on the PATH and a source is newer than the bundle, the bundle is
       rebuilt before the .NET build. Skip with -p:ChartAiSkipEngineBuild=true.
       CI byte-compares the committed bundle with one built by the Bun version pinned in
       .github/workflows/ci.yml and release.yml, and Bun's output can change between versions,
       so another Bun version does not rebuild it (a warning says so); pass
       -p:ChartAiAnyBunVersion=true to build with it anyway. -->
  <PropertyGroup>
    <ChartAiEngineDir>$(MSBuildProjectDirectory)/engine</ChartAiEngineDir>
    <ChartAiEngineBundle>$(MSBuildProjectDirectory)/wwwroot/chartai.js</ChartAiEngineBundle>
    <ChartAiBunVersion>1.4.2</ChartAiBunVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);engine/node_modules/**;engine/.build/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ChartAiEngineSource Include="$(ChartAiEngineDir)/src/**/*.ts;$(ChartAiEngineDir)/build.ts"
                         Exclude="$(ChartAiEngineDir)/src/worker-inline.ts" />
    <!-- The SDK's default Content glob would otherwise ship engine/*.json as contentFiles of the
         NuGet package. Nothing under engine/ belongs in the package; the sources stay visible in
         the IDE as None items. -->
    <Content Remove="engine/**" />
    <None Include="engine/package.json;engine/tsconfig.json;engine/bun.lock" />
  </ItemGroup>

  <Target Name="BuildChartAiEngine"
          BeforeTargets="BeforeBuild"
          Inputs="@(ChartAiEngineSource)"
          Outputs="$(ChartAiEngineBundle)"
          Condition="'$(ChartAiSkipEngineBuild)' != 'true'">
    <Exec Command="bun --version"
          IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          EchoOff="true">
      <Output TaskParameter="ExitCode" PropertyName="_ChartAiBunExitCode" />
      <Output TaskParameter="ConsoleOutput" PropertyName="_ChartAiBunOutput" />
    </Exec>
    <PropertyGroup>
      <_ChartAiBunFound>false</_ChartAiBunFound>
      <_ChartAiBunFound Condition="'$(_ChartAiBunExitCode)' == '0'">true</_ChartAiBunFound>
      <_ChartAiBunFoundVersion Condition="'$(_ChartAiBunFound)' == 'true'">$(_ChartAiBunOutput.Trim())</_ChartAiBunFoundVersion>
      <_ChartAiRunBun>false</_ChartAiRunBun>
      <_ChartAiRunBun Condition="'$(_ChartAiBunFound)' == 'true' And ('$(_ChartAiBunFoundVersion)' == '$(ChartAiBunVersion)' Or '$(ChartAiAnyBunVersion)' == 'true')">true</_ChartAiRunBun>
    </PropertyGroup>
    <Warning Condition="'$(_ChartAiBunFound)' != 'true'"
             Text="engine/src is newer than wwwroot/chartai.js but Bun is not installed, so the committed bundle is used as is. Install Bun $(ChartAiBunVersion) (https://bun.sh) and rebuild, or run 'bun run build.ts' in $(ChartAiEngineDir)." />
    <Warning Condition="'$(_ChartAiBunFound)' == 'true' And '$(_ChartAiRunBun)' != 'true'"
             Text="engine/src is newer than wwwroot/chartai.js, but Bun $(_ChartAiBunFoundVersion) is installed and the bundle is built with Bun $(ChartAiBunVersion) (the version CI checks it against), so the committed bundle is used as is. Install Bun $(ChartAiBunVersion), or pass -p:ChartAiAnyBunVersion=true to build with this version (CI rejects a bundle that differs from its own build)." />
    <Warning Condition="'$(_ChartAiRunBun)' == 'true' And '$(_ChartAiBunFoundVersion)' != '$(ChartAiBunVersion)'"
             Text="Building wwwroot/chartai.js with Bun $(_ChartAiBunFoundVersion) instead of $(ChartAiBunVersion): CI rejects the bundle if it differs from what Bun $(ChartAiBunVersion) builds." />
    <Message Condition="'$(_ChartAiRunBun)' == 'true'" Importance="high"
             Text="Building wwwroot/chartai.js from engine/src with Bun $(_ChartAiBunFoundVersion)" />
    <Exec Condition="'$(_ChartAiRunBun)' == 'true'"
          Command="bun run build.ts"
          WorkingDirectory="$(ChartAiEngineDir)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.8" />
  </ItemGroup>

</Project>
